#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    # hostname is only a first-boot placeholder; configure_worker_net.sh sets the real one
    hostname: node03
    username: rhuyvaer
    # SHA-512 hash, NOT the plain password. Generate with:  openssl passwd -6
    password: "REDACTED"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  apt:
    fallback: offline-install
    geoip: false

  # Late commands run right before the installer finishes, so nothing is pulled from the web
  late-commands:
    # 1. use the head node repo as the only package source
    - curtin in-target --target=/target -- sh -c 'echo "deb [trusted=yes] http://192.168.10.1:8085/cluster-repo ./" > /etc/apt/sources.list.d/cluster.list'
    - curtin in-target --target=/target -- sh -c 'mv /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources.bak || true'
    - curtin in-target --target=/target -- apt-get update

    # 2. base packages only. OpenMPI, OpenBLAS and HPL come from the shared /apps,
    #    and setup_worker_nfs.sh installs the runtime libraries, NFS mounts, chrony, etc.
    - curtin in-target --target=/target -- apt-get install -y build-essential htop git gfortran nfs-common
