DEFAULT ubuntu-autoinstall
PROMPT 0
TIMEOUT 50

LABEL ubuntu-autoinstall
	MENU LABEL Install Ubuntu Server (Auto-Installer)
	KERNEL ubuntu/vmlinuz
	INITRD ubuntu/initrd
	APPEND ip=dhcp netboot=nfs nfsroot=192.168.10.1:/srv/nfs/ubuntu-iso autoinstall ds=nocloud-net;s=http://192.168.10.1:8085/autoinstall/ ---
